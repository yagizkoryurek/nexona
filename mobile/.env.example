# Copy to .env.local and fill in. Same Supabase project as the web app.
#
# EXPO_PUBLIC_* is Expo's equivalent of Next's NEXT_PUBLIC_*: Metro inlines
# these into the app bundle at build time. Both values below are safe to ship
# in a client bundle — the anon key is designed to be public, and Row Level
# Security is what protects the data.
#
# GEMINI_API_KEY is deliberately absent and must NEVER be added here. It is
# server-only. Every AI call goes through the web app's /api/mobile/* routes,
# which hold that key server-side.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional override for the base URL of the Next.js app serving /api/mobile/*.
# Leave it unset. In development the app derives the host automatically from
# Expo's own Metro dev-server address (Constants.expoConfig.hostUri) and always
# talks to port 3000, so a local `next dev` server is reached out of the box
# from both the iOS Simulator and a physical iPhone — no LAN IP to maintain,
# and nothing to go stale when DHCP hands the Mac a new address. Release builds
# fall back to the deployed origin. See lib/env.ts for the precedence.
#
# Set this only to override that: a backend on a port other than 3000, `expo
# start --tunnel` (the tunnel does not forward port 3000), a `next dev` running
# on a different machine, or forcing a dev build to hit production. When set it
# wins unconditionally. Note that this file overrides a variable exported in
# the shell (expo/virtual/env spreads .env.local last), so set it here, not
# in the shell — a shell export is silently ignored on device.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# REQUIRED for resume upload to work. Not optional despite the default below.
#
# Expo SDK 57 replaces globalThis.fetch with its own expo/fetch unless this is
# set (see expo/src/winter/runtime.native.ts). That implementation rejects
# React Native's proprietary { uri, name, type } FormData part with
# "Unsupported FormDataPart implementation" — which is exactly how
# lib/resume-analysis.ts sends a picked file on iOS/Android. The throw happens
# while building the multipart body, before any request is sent, so it surfaces
# as the network-error copy in lib/api.ts rather than as anything server-side.
#
# Setting this restores RN's XHR-based fetch, which supports that part
# (react-native/Libraries/Network/FormData.js: "a 'blob' … in React Native just
# means an object with a `uri` attribute").
#
# Because EXPO_PUBLIC_* is inlined at build time, this must be set in EVERY
# build environment — local, EAS, and CI. If it is missing from a release
# build, resume upload fails there and nowhere else. The durable alternative is
# to send a real Blob/File instead and drop this flag.
EXPO_PUBLIC_USE_RN_FETCH=1
