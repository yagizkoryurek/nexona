# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). Both values are safe to expose to the browser:
# the anon key is designed to be public, and data is protected by Row Level
# Security rather than key secrecy.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# From Google AI Studio (aistudio.google.com/apikey). Server-only — never
# expose this one to the browser, unlike the two Supabase values above.
GEMINI_API_KEY=your-gemini-api-key
